|
+-- QualityCertificationServiceApplication.java
+-- controllers/       # Endpoints HTTP REST
+-- dto/               # Objets échangés avec l'API
+-- entity/            # Entités JPA persistées en base
+-- enums/             # États et types métier
+-- exception/         # Exceptions métier et gestion centralisée
+-- mapper/             # Interfaces MapStruct DTO <-> entité
